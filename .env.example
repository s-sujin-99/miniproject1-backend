# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=pharmaprice
DB_USERNAME=pharmaprice
DB_PASSWORD=changeme

# JWT (32바이트 이상 랜덤 문자열로 교체할 것)
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_EXPIRATION_MS=86400000

# Google OAuth2 (Google Cloud Console에서 발급). 비워두면 앱은 정상 기동하고
# /oauth2/authorization/google 만 동작하지 않는다(client-id/secret 없이는 기동 자체가 실패하므로
# application.properties가 "unconfigured" 기본값을 채운다).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
