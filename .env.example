# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=pharmaprice
DB_USERNAME=pharmaprice
DB_PASSWORD=changeme

# JWT (32바이트 이상 랜덤 문자열로 교체할 것)
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_EXPIRATION_MS=86400000

# Google OAuth2 (Google Cloud Console에서 발급, 아직 미구현 — 다음 태스크에서 사용)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
